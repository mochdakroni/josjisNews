APP_NAME="Josjis News API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://josjis.news

# Database (PostgreSQL / MariaDB)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=josjis_news
DB_USERNAME=postgres
DB_PASSWORD=secret

# Redis Cache & Queue
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache

# S3-Compatible Storage (Cloudflare R2 / MinIO)
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=your-r2-or-minio-access-key
AWS_SECRET_ACCESS_KEY=your-r2-or-minio-secret-key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=josjis-news-media
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_URL=https://cdn.josjisnews.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS Configuration untuk Frontend Web Publik
CORS_ALLOWED_ORIGINS=https://josjis.news,https://www.josjis.news,http://josjis.news,http://www.josjis.news
CORS_ALLOWED_ORIGIN_PATTERN=
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=86400
