# Salin menjadi .env lalu sesuaikan. Berkas .env TIDAK pernah disajikan ke publik.
APP_URL=https://josjisnews.com
SITE_NAME=JosjisNews
SITE_TAGLINE="Bloko Sutho"
COMPANY_NAME="PT Sendhiko Dawuh Multiguna"

# Info redaksi (tampil di halaman Redaksi, Kontak, & Pasang Iklan)
CONTACT_EMAIL=redaksi@josjisnews.com
ADS_EMAIL=iklan@josjisnews.com
CONTACT_PHONE=
CONTACT_ADDRESS=
EDITOR_IN_CHIEF=

# Akun admin awal saat database dibuat pertama kali (kosongkan = password acak,
# dicetak CLI dan disimpan di storage/data/INITIAL_ADMIN_PASSWORD.txt)
ADMIN_EMAIL=admin@josjisnews.com
ADMIN_PASSWORD=

# Lokasi database SQLite (relatif terhadap root proyek, atau absolut)
DB_PATH=storage/data/database.sqlite

# Isi 1 bila di belakang Nginx/Cloudflare agar IP asli pengunjung dipakai
TRUSTED_PROXY=0

# Opsional: izinkan origin lain memanggil API (mis. frontend terpisah)
CORS_ORIGIN=

# Daftar host yang sah, dipisah koma (wajib diisi di produksi; cegah host-header poisoning)
ALLOWED_HOSTS=

# Wajibkan 2FA untuk super_admin & editor (1 = wajib). Disarankan di produksi setelah semua staf mendaftarkan 2FA.
REQUIRE_2FA=0

# Kunci enkripsi rahasia 2FA. Kosong = dibuat otomatis di storage/data/app.key (cadangkan berkas itu!).
# Untuk mengisi manual: APP_KEY=base64:$(openssl rand -base64 32)
APP_KEY=
